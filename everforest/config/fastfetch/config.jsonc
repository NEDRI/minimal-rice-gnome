// Lorien Everforest: the small distro logo and one coloured icon per line
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "width": 10
        }
    },
    "modules": [
        {
            "type": "title",
            "key": " hname",
            "keyColor": "38;2;167;192;128",
            "format": "{host-name}"
        },
        {
            "type": "uptime",
            "key": " uptime",
            "keyColor": "38;2;219;188;127"
        },
        {
            "type": "os",
            "key": " distro",
            "keyColor": "38;2;127;187;179"
        },
        {
            "type": "kernel",
            "key": " kernel",
            "keyColor": "38;2;230;126;128"
        },
        {
            "type": "de",
            "key": " desktop",
            "keyColor": "38;2;214;153;182"
        },
        {
            "type": "terminal",
            "key": " term",
            "keyColor": "38;2;131;192;146"
        },
        {
            "type": "shell",
            "key": " shell",
            "keyColor": "38;2;230;152;117"
        },
        {
            "type": "colors",
            "symbol": "circle",
            "key": " colors",
            "keyColor": "38;2;167;192;128"
        }
    ]
}
