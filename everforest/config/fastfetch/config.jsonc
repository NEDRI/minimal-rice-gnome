// Lorien Everforest: the small distro logo and one coloured icon per line
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "width": 10
        }
    },
    "modules": [
        {
            "type": "title",
            "key": " hname",
            "keyColor": "38;2;195;204;214",
            "format": "{host-name}"
        },
        {
            "type": "uptime",
            "key": " uptime",
            "keyColor": "38;2;169;182;195"
        },
        {
            "type": "os",
            "key": " distro",
            "keyColor": "38;2;143;159;176"
        },
        {
            "type": "kernel",
            "key": " kernel",
            "keyColor": "38;2;208;120;124"
        },
        {
            "type": "de",
            "key": " desktop",
            "keyColor": "38;2;180;154;196"
        },
        {
            "type": "terminal",
            "key": " term",
            "keyColor": "38;2;143;182;184"
        },
        {
            "type": "shell",
            "key": " shell",
            "keyColor": "38;2;214;154;122"
        },
        {
            "type": "colors",
            "symbol": "circle",
            "key": " colors",
            "keyColor": "38;2;195;204;214"
        }
    ]
}
